# Managed by Ansible. Backends are published on the homelab's host address.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen {{ ansible_host }}:{{ nginx.HTTP_PORT }} default_server;
    server_name _;
    return 444;
}

server {
    listen {{ ansible_host }}:{{ nginx.HTTP_PORT }};
    server_name pihole.home.arpa glance.home.arpa immich.home.arpa trilium.home.arpa karakeep.home.arpa;
    return 301 https://$host$request_uri;
}

server {
    listen {{ ansible_host }}:{{ nginx.PUBLIC_PORT }} ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/mkcert/homelab.pem;
    ssl_certificate_key /etc/nginx/mkcert/homelab-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 444;
}

{% for service, port in [('pihole', pihole.PUBLIC_PORT), ('glance', glance.PUBLIC_PORT), ('immich', immich.PUBLIC_PORT), ('trilium', trilium.PUBLIC_PORT), ('karakeep', karakeep.PUBLIC_PORT)] %}
server {
    listen {{ ansible_host }}:{{ nginx.PUBLIC_PORT }} ssl;
    server_name {{ service }}.home.arpa;

    ssl_certificate /etc/nginx/mkcert/homelab.pem;
    ssl_certificate_key /etc/nginx/mkcert/homelab-key.pem;
    client_max_body_size 100m;

{% if service == 'pihole' %}
    location = / {
        return 302 /admin/;
    }
{% endif %}
    location / {
        proxy_pass http://{{ ansible_host }}:{{ port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
{% if service == 'immich' %}
        # Large uploads and long-running video requests.
        client_max_body_size 0;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
{% endif %}
{% if service == 'trilium' %}
        proxy_read_timeout 3600s;
{% endif %}
    }
}

{% endfor %}
