services:
  glance:
    image: glanceapp/glance:latest
    container_name: glance
    restart: unless-stopped
    ports:
      - "{{ ansible_host }}:{{ glance.PUBLIC_PORT }}:8080"
    environment:
      TZ: Australia/Perth
      HOMELAB_IP: "{{ ansible_host }}"
      HOST_PROC: /host/proc
      HOST_SYS: /host/sys
      PIHOLE_APP_PASSWORD: ${PIHOLE_APP_PASSWORD:-}
      TRILIUM_PUBLIC_PORT: "{{ trilium.PUBLIC_PORT }}"
      KARAKEEP_PUBLIC_PORT: "{{ karakeep.PUBLIC_PORT }}"
      IMMICH_PUBLIC_PORT: "{{ immich.PUBLIC_PORT }}"
    volumes:
      - ./glance.yml:/app/config/glance.yml:ro
      - ./stats.css:/app/assets/stats.css:ro
      # Read-only host mounts let the server-stats widget report host CPU,
      # memory and root disk usage instead of container-only statistics.
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
      - /:/host/root:ro
    networks:
      - default
      - pihole

  uptime:
    image: python:3.13-alpine
    restart: unless-stopped
    read_only: true
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    command: python -u /app/uptime.py
    volumes:
      - ./uptime.py:/app/uptime.py:ro
      - /proc:/host/proc:ro

networks:
  pihole:
    external: true
    name: pihole_default
